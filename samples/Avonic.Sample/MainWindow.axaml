<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Avonic.Sample"
        x:Class="Avonic.Sample.MainWindow"
        Title="Avonic"
        Width="390" Height="844" CanResize="False"
        Background="White">

    <!-- Phone-sized, on desktop. The sample itself is SampleShell, which a phone shows on its own. -->
    <local:SampleShell Name="Shell" />

</Window>
