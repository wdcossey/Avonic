<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Avonic.Components.Controls"
             x:Class="Avonic.Sample.Pages.OverlaysPage">

    <!-- The overlay system (#5) and ion-backdrop. The overlays here are a test vehicle, SampleOverlay below, until the real
         ones (alert, action sheet, loading, modal, popover, toast) come: a backdrop with a box on it. -->
    <c:AvonicContent>
        <StackPanel>
            <c:AvonicListHeader>
                <TextBlock Text="ion-backdrop on its own" />
            </c:AvonicListHeader>
            <Panel Height="96" Margin="16,8" Background="{DynamicResource Avonic.BackgroundColorBrush}">
                <TextBlock Name="BackdropStatus" Margin="12" Text="Tap the backdrop" />
                <!-- At an overlay's opacity, so that it can be seen. -->
                <c:AvonicBackdrop Name="Standalone" Opacity="{DynamicResource Avonic.BackdropOpacity}" />
            </Panel>
            <c:AvonicItem>
                <c:AvonicLabel>
                    <TextBlock Text="Tappable" />
                </c:AvonicLabel>
                <c:AvonicItem.EndContent>
                    <CheckBox Name="Tappable" IsChecked="True" />
                </c:AvonicItem.EndContent>
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicLabel>
                    <TextBlock Text="Visible" />
                </c:AvonicLabel>
                <c:AvonicItem.EndContent>
                    <CheckBox Name="Visible" IsChecked="True" />
                </c:AvonicItem.EndContent>
            </c:AvonicItem>

            <c:AvonicListHeader>
                <TextBlock Text="Overlays" />
            </c:AvonicListHeader>
            <c:AvonicItem>
                <c:AvonicLabel>
                    <TextBlock Name="Status" Text="Present one, then tap the backdrop, press Escape or Back, or Tab" TextWrapping="Wrap" />
                </c:AvonicLabel>
            </c:AvonicItem>
            <c:AvonicButton Name="Present" Content="Present an overlay" Margin="16,8,16,0" />
            <c:AvonicButton Name="PresentLocked" Content="Present one the backdrop can't dismiss" Margin="16,8,16,0" />
            <c:AvonicButton Name="PresentStill" Content="Present one with no animation" Margin="16,8,16,0" />
        </StackPanel>
    </c:AvonicContent>

</UserControl>
