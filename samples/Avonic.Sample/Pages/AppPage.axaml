<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Avonic.Components.Controls"
             x:Class="Avonic.Sample.Pages.AppPage">

    <!-- ion-app around a page, so that the back button, the keyboard's events and the status tap are started while it's shown.
         The shell's own back still takes the page back when nothing here takes it. -->
    <c:AvonicApp Name="App">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="#F4F5F8" Padding="8">
                <WrapPanel>
                    <ToggleButton Name="TakeBack" Content="Take back at 0" Margin="2" />
                    <Button Name="Tap" Content="Status tap" Margin="2" />
                    <Button Name="Ring" Content="SetFocus on row 1" Margin="2" />
                </WrapPanel>
            </Border>

            <c:AvonicContent Name="Main" Grid.Row="1">
                <StackPanel Name="Rows" />
            </c:AvonicContent>

            <Border Grid.Row="2" Background="#F4F5F8" Padding="8">
                <TextBlock Name="Status" TextWrapping="Wrap" Text="Press back, open the keyboard on the last row, or tap Status tap after a scroll" />
            </Border>
        </Grid>
    </c:AvonicApp>

</UserControl>
