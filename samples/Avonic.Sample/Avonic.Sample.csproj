<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sample, shared by its heads: Avonic.Sample.Desktop and Avonic.Sample.Android. See docs/infra/android/PLAN.md. -->
  <PropertyGroup>
    <!-- On the current runtime, as its heads are. Avalonia 12 on Android needs net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Window, ScrollViewer, TextBlock etc. need a base theme; Avonic styles only Avonic controls. -->
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <!-- Roboto, for the sample and the tests, from the files the Chromium tools load: see Roboto.cs and tools/fonts/roboto/README.md. -->
  <ItemGroup>
    <AvaloniaResource Include="../../tools/fonts/roboto/*.ttf" Link="Fonts/Roboto/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The pictures the ion-img page ships with: see Assets/Img/README.md. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**/*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avonic\Avonic.csproj" />
  </ItemGroup>

</Project>
