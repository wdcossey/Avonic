<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop head: Program.cs, and the sample itself from Avonic.Sample. See docs/infra/android/PLAN.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- An app, not a library: run on the current runtime (also avoids needing an older apphost pack). -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- -p:AvonicPerf=true: a Release build with the page-cost line, which also opens every page by itself and logs what each cost
       (docs/infra/performance/README.md, "Page costs on a device"). -->
  <PropertyGroup Condition="'$(AvonicPerf)' == 'true'">
    <DefineConstants>$(DefineConstants);AVONIC_PERF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avonic.Sample\Avonic.Sample.csproj" />
  </ItemGroup>

</Project>
