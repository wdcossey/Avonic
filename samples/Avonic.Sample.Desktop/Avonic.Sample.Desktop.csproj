<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop head: Program.cs, and the sample itself from Avonic.Sample. See docs/infra/android/PLAN.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- An app, not a library: run on the current runtime (also avoids needing an older apphost pack). -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avonic.Sample\Avonic.Sample.csproj" />
  </ItemGroup>

</Project>
