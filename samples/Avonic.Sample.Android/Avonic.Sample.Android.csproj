<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sample's Android head: MainActivity and the Application class, and the sample itself from Avonic.Sample. It's not in
    Avonic.sln, so that building and testing the solution don't need the android workload; CI's android job builds it. See
    docs/infra/android/README.md for building, installing and what to check on a device.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Avalonia 12 supports net10.0 alone on Android. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <ApplicationId>io.github.wdcossey.avonic.sample</ApplicationId>
    <ApplicationTitle>Avonic</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The assemblies go in the APK in a Debug build too, so that `adb install` alone is enough: fast deployment would need the
         device during the build. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- -p:AvonicPerf=true: a Release build with the page-cost line, which also opens every page by itself and logs what each cost
       (docs/infra/performance/README.md, "Page costs on a device"). -->
  <PropertyGroup Condition="'$(AvonicPerf)' == 'true'">
    <DefineConstants>$(DefineConstants);AVONIC_PERF</DefineConstants>
    <!-- MetricsSupport stays off, as .NET for Android has it: turned on, Avalonia's meter fills the layout column but makes every
         page 6 to 10 times slower on a Pixel 8 (measured 2026-11-20), so on Android only the total is measured. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avonic.Sample\Avonic.Sample.csproj" />
  </ItemGroup>

</Project>
