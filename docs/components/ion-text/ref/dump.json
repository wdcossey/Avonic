{
  "tag": "ion-text",
  "snippet": "<div>Some words and <ion-text color=\"primary\">some coloured ones which wrap around with the words either side of them</ion-text> and then some more words after.</div><div>Nested: <ion-text color=\"danger\">red, <ion-text color=\"success\">green</ion-text>, <ion-text>still red</ion-text></ion-text>.</div><ion-text color=\"secondary\"><div>A block</div><div>Another block</div></ion-text><div><ion-text color=\"danger\"><ion-icon name=\"heart\"></ion-icon></ion-text></div><ion-item><ion-text color=\"danger\">In an item</ion-text></ion-item><ion-item color=\"primary\"><ion-text>Follows a primary item</ion-text></ion-item><ion-item color=\"primary\"><ion-text color=\"light\">Light in a primary item</ion-text></ion-item><ion-item><ion-label>In the end slot</ion-label><ion-text slot=\"end\" color=\"danger\">End</ion-text></ion-item><ion-item><ion-label><h2>Heading with <ion-text color=\"danger\">red</ion-text></h2><p>Paragraph with <ion-text color=\"primary\">blue</ion-text> in it</p></ion-label></ion-item>",
