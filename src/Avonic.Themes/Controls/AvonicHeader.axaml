<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390" Height="120">
            <c:AvonicHeader>
                <c:AvonicToolbar>
                    <c:AvonicTitle Content="Header" />
                </c:AvonicToolbar>
            </c:AvonicHeader>
        </StackPanel>
    </Design.PreviewWith>

    <!-- A translation of header.md.css. What it does to its toolbars is in Styles/Toolbar.axaml. -->
    <ControlTheme x:Key="{x:Type c:AvonicHeader}" TargetType="c:AvonicHeader">
        <!-- position: relative; z-index: 10, so the shadow draws over what comes after it -->
        <Setter Property="ZIndex" Value="10" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Native" BoxShadow="{DynamicResource Avonic.Header.BoxShadow}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- .header-md.ion-no-border { box-shadow: none } -->
        <Style Selector="^.ion-no-border /template/ Border#PART_Native">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
