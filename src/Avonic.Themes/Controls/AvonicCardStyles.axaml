<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avonic="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <Border Background="#F2F2F7" Padding="0" MinWidth="320" MinHeight="200">
            <StackPanel>
                <avonic:AvonicCard>
                    <StackPanel Padding="16">
                        <TextBlock Text="Static Card" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Cards group related content." TextWrapping="Wrap" Foreground="#71717A" />
                    </StackPanel>
                </avonic:AvonicCard>
                <avonic:AvonicCard Button="True">
                    <StackPanel Padding="16">
                        <TextBlock Text="Tappable Card" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Button=True makes this interactive." Foreground="#71717A" />
                    </StackPanel>
                </avonic:AvonicCard>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ── Base ─────────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicCard">
        <Setter Property="Background"          Value="{DynamicResource Avonic.BackgroundBrush}" />
        <Setter Property="Foreground"          Value="{DynamicResource Avonic.ForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin"              Value="{DynamicResource Avonic.Card.Margin}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Avonic.CornerRadius.Rounded}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource Avonic.Color.CardShadow}"
                                          BlurRadius="12"
                                          OffsetX="0" OffsetY="2"
                                          Opacity="1" />
                    </Border.Effect>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── Button mode: pointer cursor ───────────────────────────────────────── -->
    <Style Selector="avonic|AvonicCard:button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── Button mode: pressed overlay ─────────────────────────────────────── -->
    <Style Selector="avonic|AvonicCard:button:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Avonic.PressedBrush}" />
    </Style>

    <!-- ── Disabled ──────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicCard:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

</Styles>
