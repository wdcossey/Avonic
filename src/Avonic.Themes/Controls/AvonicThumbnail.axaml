<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors"
                    xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390" Spacing="8">
            <c:AvonicThumbnail Background="{DynamicResource Avonic.Color.PrimaryBrush}" />
            <c:AvonicItem Content="In an item">
                <c:AvonicItem.StartContent>
                    <c:AvonicThumbnail Background="{DynamicResource Avonic.Color.PrimaryBrush}" />
                </c:AvonicItem.StartContent>
            </c:AvonicItem>
        </StackPanel>
    </Design.PreviewWith>

    <!-- A translation of thumbnail.css's host. The image inside, and the sizes in an item, are in Styles/Thumbnail.axaml. -->
    <ControlTheme x:Key="{x:Type c:AvonicThumbnail}" TargetType="c:AvonicThumbnail">
        <!-- width: var(size); height: var(size), where size is 48 -->
        <Setter Property="Width">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Thumbnail.Size" />
                <DynamicResource ResourceKey="Avonic.Thumbnail.Md.Size" />
            </MultiBinding>
        </Setter>
        <Setter Property="Height">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Thumbnail.Size" />
                <DynamicResource ResourceKey="Avonic.Thumbnail.Md.Size" />
            </MultiBinding>
        </Setter>
        <!-- border-radius: var(border-radius), which is 0 -->
        <Setter Property="CornerRadius">
            <MultiBinding Converter="{x:Static c:BorderRadius.ToCornerRadius}">
                <DynamicResource ResourceKey="Avonic.Thumbnail.BorderRadius" />
                <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
        <!-- display: block, which starts at the left at its own width -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
