<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avonic="using:Avonic.Components.Controls"
        xmlns:avonicPrimitives="using:Avonic.Components.Primitives">

    <Design.PreviewWith>
        <Border Background="#F2F2F7" MinWidth="360" MinHeight="160">
            <StackPanel>
                <avonic:AvonicItemSliding>
                    <avonic:AvonicItemSliding.EndOptions>
                        <avonic:AvonicItemOptions>
                            <avonic:AvonicItemOption Color="Danger">Delete</avonic:AvonicItemOption>
                        </avonic:AvonicItemOptions>
                    </avonic:AvonicItemSliding.EndOptions>
                    <avonic:AvonicItem Lines="Inset">
                        <avonic:AvonicLabel>Swipe left to delete</avonic:AvonicLabel>
                    </avonic:AvonicItem>
                </avonic:AvonicItemSliding>
                <avonic:AvonicItemSliding>
                    <avonic:AvonicItemSliding.StartOptions>
                        <avonic:AvonicItemOptions Side="Start">
                            <avonic:AvonicItemOption Color="Success">Favourite</avonic:AvonicItemOption>
                        </avonic:AvonicItemOptions>
                    </avonic:AvonicItemSliding.StartOptions>
                    <avonic:AvonicItemSliding.EndOptions>
                        <avonic:AvonicItemOptions>
                            <avonic:AvonicItemOption Color="Warning">Archive</avonic:AvonicItemOption>
                            <avonic:AvonicItemOption Color="Danger">Delete</avonic:AvonicItemOption>
                        </avonic:AvonicItemOptions>
                    </avonic:AvonicItemSliding.EndOptions>
                    <avonic:AvonicItem Lines="None">
                        <avonic:AvonicLabel>Swipe either side</avonic:AvonicLabel>
                    </avonic:AvonicItem>
                </avonic:AvonicItemSliding>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- AvonicItemSliding                                                      -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <Style Selector="avonic|AvonicItemSliding">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds"        Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- ClipToBounds on the root prevents options overflowing -->
                <Panel Name="PART_Root" ClipToBounds="True">

                    <!-- Start options — positioned at the left, revealed by swiping right -->
                    <ContentPresenter Name="PART_StartOptions"
                                      Content="{TemplateBinding StartOptions}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch" />

                    <!-- End options — positioned at the right, revealed by swiping left -->
                    <ContentPresenter Name="PART_EndOptions"
                                      Content="{TemplateBinding EndOptions}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Stretch" />

                    <!-- Main content — sits on top; translate drives the swipe -->
                    <ContentPresenter Name="PART_Content"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch" />

                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── Disabled ──────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicItemSliding:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- AvonicItemOptions                                                      -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <Style Selector="avonic|AvonicItemOptions">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- AvonicItemOption                                                       -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <Style Selector="avonic|AvonicItemOption">
        <Setter Property="Background"   Value="{DynamicResource Avonic.MutedBrush}" />
        <Setter Property="Foreground"   Value="{DynamicResource Avonic.ForegroundBrush}" />
        <Setter Property="MinWidth"     Value="{DynamicResource Avonic.ItemOption.MinWidth}" />
        <Setter Property="MinHeight"    Value="48" />
        <Setter Property="Cursor"       Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        ClipToBounds="True">
                    <Panel>
                        <avonicPrimitives:AvonicRipple
                            RippleFill="{DynamicResource Avonic.PrimaryForegroundBrush}" />

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="4"
                                    Margin="16,8">
                            <!-- Icon slot -->
                            <ContentPresenter Name="PART_StartContent"
                                              Content="{TemplateBinding StartContent}"
                                              ContentTemplate="{TemplateBinding StartContentTemplate}"
                                              HorizontalAlignment="Center"
                                              IsVisible="{Binding StartContent,
                                                                   RelativeSource={RelativeSource TemplatedParent},
                                                                   Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <!-- Label -->
                            <ContentPresenter Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{DynamicResource Avonic.FontSize.Small}"
                                              HorizontalAlignment="Center"
                                              IsVisible="{Binding IconOnly,
                                                                   RelativeSource={RelativeSource TemplatedParent},
                                                                   Converter={x:Static BoolConverters.Not}}" />
                        </StackPanel>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── Colour variants ───────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicItemOption:color-primary">
        <Setter Property="Background" Value="{DynamicResource Avonic.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Avonic.PrimaryForegroundBrush}" />
    </Style>
    <Style Selector="avonic|AvonicItemOption:color-danger">
        <Setter Property="Background" Value="{DynamicResource Avonic.DestructiveBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="avonic|AvonicItemOption:color-success">
        <Setter Property="Background" Value="{DynamicResource Avonic.SuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="avonic|AvonicItemOption:color-warning">
        <Setter Property="Background" Value="{DynamicResource Avonic.WarningBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Avonic.ForegroundBrush}" />
    </Style>

    <!-- ── Pressed ───────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicItemOption:pressed /template/ Border#PART_Root">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- ── Disabled ──────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicItemOption:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

</Styles>
