<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avonic="using:Avonic.Components.Controls">

    <Style Selector="avonic|AvonicList">
        <Setter Property="Background"          Value="{DynamicResource Avonic.BackgroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="0" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Avonic.CornerRadius.None}">
                    <ItemsPresenter Name="PART_ItemsPresenter" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Inset: rounded corners + horizontal margin -->
    <Style Selector="avonic|AvonicList:inset">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style Selector="avonic|AvonicList:inset /template/ Border#PART_Root">
        <Setter Property="CornerRadius"   Value="{DynamicResource Avonic.CornerRadius.Default}" />
        <Setter Property="ClipToBounds"   Value="True" />
    </Style>


</Styles>
