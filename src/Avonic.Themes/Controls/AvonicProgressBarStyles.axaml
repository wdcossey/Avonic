<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avonic="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <Border Background="White" Padding="24" MinWidth="320" MinHeight="140">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Determinate — 75%" FontSize="12" Foreground="#71717A" />
                    <avonic:AvonicProgressBar Value="0.75" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Determinate — 40% (buffer 80%)" FontSize="12" Foreground="#71717A" />
                    <avonic:AvonicProgressBar Value="0.4" Buffer="0.8" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Indeterminate" FontSize="12" Foreground="#71717A" />
                    <avonic:AvonicProgressBar Type="Indeterminate" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ── Base ─────────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicProgressBar">
        <Setter Property="Background"          Value="{DynamicResource Avonic.MutedBrush}" />
        <Setter Property="Foreground"          Value="{DynamicResource Avonic.PrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height"              Value="{DynamicResource Avonic.ProgressBar.Height}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Outer container clips animated bar for indeterminate mode -->
                <Border CornerRadius="{DynamicResource Avonic.CornerRadius.Pill}"
                        ClipToBounds="True"
                        Height="{TemplateBinding Height}">
                    <Panel>
                        <!-- Track (background) -->
                        <Border Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}" />

                        <!-- Buffer bar — secondary indicator for streaming/buffering -->
                        <Border Name="PART_Buffer"
                                Background="{DynamicResource Avonic.ProgressBar.BufferBrush}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                IsVisible="False" />

                        <!-- Progress fill -->
                        <Border Name="PART_Progress"
                                Background="{TemplateBinding Foreground}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── Buffer bar: visible when buffer < 1 (non-trivial) ─────────────────── -->
    <!-- The code sets PART_Buffer.Width, so just make it visible in themed mode -->
    <Style Selector="avonic|AvonicProgressBar:determinate /template/ Border#PART_Buffer">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ── Indeterminate: looping animation ──────────────────────────────────── -->
    <Style Selector="avonic|AvonicProgressBar:indeterminate /template/ Border#PART_Progress">
        <Setter Property="Width" Value="120" />
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="-200" />
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="600" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Hide buffer bar in indeterminate mode -->
    <Style Selector="avonic|AvonicProgressBar:indeterminate /template/ Border#PART_Buffer">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Reversed ──────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicProgressBar:reversed /template/ Border#PART_Progress">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="avonic|AvonicProgressBar:reversed /template/ Border#PART_Buffer">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ── Disabled ──────────────────────────────────────────────────────────── -->
    <Style Selector="avonic|AvonicProgressBar:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

</Styles>
