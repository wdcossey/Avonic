<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors"
                    xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390" Background="White" Margin="16" Spacing="8">
            <c:AvonicImg Alt="A picture that hasn't loaded" />
            <c:AvonicImg Width="120" Height="60" HorizontalAlignment="Left" />
            <c:AvonicAvatar>
                <c:AvonicImg Alt="In an avatar" />
            </c:AvonicAvatar>
        </StackPanel>
    </Design.PreviewWith>

    <!-- The broken-image icon, 16 by 16 as Chromium's is: Avonic's own drawing, a square with a 1 px border and a cross from
         corner to corner, standing in for the browser's artwork, which isn't Ionic's. Its colour is Avonic.Img.BrokenImageBrush. -->
    <StreamGeometry x:Key="Avonic.Img.Md.BrokenImageIcon">M0.5,0.5 H15.5 V15.5 H0.5 Z M0.5,0.5 L15.5,15.5 M15.5,0.5 L0.5,15.5</StreamGeometry>

    <!-- A translation of img.css. ion-img has no variables: it's a block as wide as its parent, with the picture in it. -->
    <ControlTheme x:Key="{x:Type c:AvonicImg}" TargetType="c:AvonicImg">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <!-- img { display: block; width: 100%; height: 100%; object-fit: inherit }, and the host's object-fit: contain.
                         As wide as the host, and as tall as the picture's aspect ratio makes it, centred in a box of its own size. -->
                    <Image Name="PART_Image" Stretch="Uniform" IsVisible="False" />
                    <!-- A browser's alt text, in the inherited font and colour, after its broken-image icon, which sits in the first
                         line as an inline image does, so the text starts 16 to the right and wraps to the left edge. Measured in
                         Chromium: the icon at the top left, the text from x 16. The line keeps an empty 16 by 16 space for it, and the
                         icon is drawn over that space, as an embedded control with a resource of its own is measured during the render, which
                         Avalonia refuses. -->
                    <!-- At least the icon's height, as the icon's line is in Chromium, at any font size -->
                    <Panel Name="PART_Alt" MinHeight="16" IsVisible="False">
                        <!-- The space has no height, so the line keeps the text's height, 19 at 16 px, as Chromium's does. No white space
                             between the two inlines, which XAML would make a space. -->
                        <TextBlock TextWrapping="Wrap"><InlineUIContainer><Border Width="16" Height="0" /></InlineUIContainer><Run Text="{TemplateBinding Alt}" /></TextBlock>
                        <Path Classes="broken-image" />
                    </Panel>
                    <!-- With no alt text, a box with a 1 px border, measured: 20 high at the top of a line 24 high, the width of the
                         host; or the host's own size, if it has one. The icon is in it 2 from the top left, when it failed. -->
                    <Border Name="PART_Broken" BorderThickness="1" Height="20" Margin="0,0,0,4" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource Avonic.Img.BrokenImageBorderBrush}" IsVisible="False">
                        <Path Name="PART_BrokenIcon" Classes="broken-image" Margin="1" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The broken-image icon, over the alt text and in the box: one rule for both -->
        <Style Selector="^ /template/ Path.broken-image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Data" Value="{DynamicResource Avonic.Img.Md.BrokenImageIcon}" />
            <Setter Property="Stroke" Value="{DynamicResource Avonic.Img.BrokenImageBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <!-- In a box of its own size, the broken-image box fills it -->
        <Style Selector="^:sized /template/ Border#PART_Broken">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- ::slotted(ion-img) in avatar.md.css and thumbnail.css: border-radius: var(border-radius); width: 100%;
             height: 100%; object-fit: cover; overflow: hidden. Here, not in Styles/, as the control works out where it is: see
             docs/components/ion-img/PLAN.md. UniformToFill is cover, cropped from the middle. The clip is on the Image, which
             Avalonia doesn't mirror in right-to-left, so its corners are physical, as CSS's are. Cover fills the box by itself: it
             measures to the whole of it, but where there is no picture, height: 100% is the host stretching to the box, which
             the broken-image box needs. -->
        <Style Selector="^:in-avatar, ^:in-thumbnail">
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:in-avatar /template/ Image#PART_Image, ^:in-thumbnail /template/ Image#PART_Image">
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>
        <!-- Chromium cuts what it shows for a missing picture to the circle too. These don't need their corners physical: a radius
             the same at every corner is the same mirrored. -->
        <Style Selector="^:in-avatar /template/ Border#PART_Broken, ^:in-avatar /template/ Panel#PART_Alt">
            <Setter Property="Clip">
                <MultiBinding Converter="{x:Static b:BorderRadius.ToClip}">
                    <DynamicResource ResourceKey="Avonic.Avatar.BorderRadius" />
                    <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="^:in-avatar /template/ Image#PART_Image">
            <Setter Property="Clip">
                <MultiBinding Converter="{x:Static b:BorderRadius.ToClip}">
                    <DynamicResource ResourceKey="Avonic.Avatar.BorderRadius" />
                    <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="^:in-thumbnail /template/ Image#PART_Image">
            <Setter Property="Clip">
                <MultiBinding Converter="{x:Static b:BorderRadius.ToClip}">
                    <DynamicResource ResourceKey="Avonic.Thumbnail.BorderRadius" />
                    <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
