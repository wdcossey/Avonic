<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390" Background="White">
            <c:AvonicReorderGroup Disabled="False">
                <c:AvonicItem>
                    <c:AvonicLabel Content="Item 1" />
                    <c:AvonicItem.EndContent><c:AvonicReorder /></c:AvonicItem.EndContent>
                </c:AvonicItem>
                <c:AvonicReorder>
                    <c:AvonicItem><c:AvonicLabel Content="Wrapped in its handle" /></c:AvonicItem>
                </c:AvonicReorder>
            </c:AvonicReorderGroup>
        </StackPanel>
    </Design.PreviewWith>

    <!-- A translation of reorder.md.css. Its shadow root is a slot whose fallback is the icon. -->
    <ControlTheme x:Key="{x:Type c:AvonicReorder}" TargetType="c:AvonicReorder">
        <!-- A host doesn't clip in CSS, and a lifted handle's shadow is outside it -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Host" Background="Transparent">
                    <Panel>
                        <!-- .reorder-icon { display: block; font-size: 1.9375rem; opacity: 0.3 } -->
                        <c:AvonicIcon Name="PART_Icon"
                                      IconName="reorder-two-sharp"
                                      FontSize="31"
                                      Opacity="0.3"
                                      IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- reorder-group.css's .reorder-selected, for a handle that wraps its item and is the group's child.
             An item's is in Styles/ReorderGroup.axaml. -->
        <Style Selector="^:reorder-selected">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="^:reorder-selected /template/ Border#PART_Host">
            <Setter Property="BoxShadow" Value="{DynamicResource Avonic.ReorderGroup.SelectedBoxShadow}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
