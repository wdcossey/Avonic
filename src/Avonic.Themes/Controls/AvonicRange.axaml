<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Avonic.Components.Animation"
                    xmlns:b="using:Avonic.Components.Behaviors"
                    xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390" Background="White">
            <c:AvonicItem>
                <c:AvonicRange Label="Label" Value="40" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange Label="Pin" Pin="True" Value="60" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange Label="Stacked" LabelPlacement="Stacked" Value="30" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange DualKnobs="True" Value="20,80" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange Snaps="True" Step="10" Value="50" StartContent="Low" EndContent="High" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange ActiveBarStart="50" Value="20" Color="danger" />
            </c:AvonicItem>
            <c:AvonicItem>
                <c:AvonicRange IsEnabled="False" Value="40" />
            </c:AvonicItem>
        </StackPanel>
    </Design.PreviewWith>

    <!-- A translation of range.md.css. The range places the parts and sets their state; this paints them. Rules that CSS adds up
         from separate selectors, such as the label's margins, are written out per combination, the most specific last. -->
    <ControlTheme x:Key="{x:Type c:AvonicRange}" TargetType="c:AvonicRange">
        <!-- font-family: var(ion-font-family, inherit) -->
        <Setter Property="FontFamily" Value="{DynamicResource Avonic.FontFamily}" />
        <!-- flex: 3, which a FlexRow reads where the range is slotted, such as an item's start or end slot. The item's default slot
             has a flex of its own, which wins. -->
        <Setter Property="c:FlexRow.Flex" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The host's padding: the item adjustments, then the pin's room as the wrapper's margin. -->
                <Border Padding="{TemplateBinding Padding}">
                    <c:RangePanel Name="PART_Wrapper" LabelPlacement="{TemplateBinding LabelPlacement}">
                        <!-- .label-text-wrapper. Its margin is per placement, below. -->
                        <Panel Name="PART_Label">
                            <!-- .label-text: plain text, wrapping. -->
                            <TextBlock Name="PART_LabelText" Text="{TemplateBinding Label}" TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Label, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <!-- ::slotted([slot=label]): max-width 200px, on one line, with an ellipsis. -->
                            <ContentPresenter Name="PART_LabelContent"
                                              Content="{TemplateBinding LabelContent}"
                                              ContentTemplate="{TemplateBinding LabelContentTemplate}"
                                              IsVisible="{TemplateBinding Label, Converter={x:Static ObjectConverters.IsNull}}"
                                              MaxWidth="200"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis" />
                        </Panel>
                        <!-- .native-wrapper: display flex, centred, font-size 0.75rem. The slider takes what the slots leave. -->
                        <Grid Name="PART_NativeWrapper" ColumnDefinitions="Auto,*,Auto" TextElement.FontSize="12">
                            <!-- ::slotted([slot=start]): 14px toward the slider. Hidden while empty, as there's no element then. -->
                            <ContentPresenter Name="PART_Start" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Content="{TemplateBinding StartContent}" ContentTemplate="{TemplateBinding StartContentTemplate}"
                                              IsVisible="{TemplateBinding StartContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <!-- .range-slider: height var(height), cursor grab, which Avalonia doesn't have. -->
                            <c:RangeSlider Name="PART_Slider" Grid.Column="1" Background="Transparent" Cursor="Hand"
                                           Height="{DynamicResource Avonic.Range.Height}">
                                <!-- .range-bar, inside .range-bar-container, which is the whole width and centred down. -->
                                <Border Name="PART_Bar" Classes="bar" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Height="{DynamicResource Avonic.Range.BarHeight}"
                                        Background="{DynamicResource Avonic.Range.BarBackground}">
                                    <Border.CornerRadius>
                                        <MultiBinding Converter="{x:Static b:BorderRadius.ToCornerRadius}">
                                            <DynamicResource ResourceKey="Avonic.Range.BarBorderRadius" />
                                            <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                                            <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Border.CornerRadius>
                                </Border>
                                <!-- .range-bar.range-bar-active: left and right from the range. -->
                                <Border Name="PART_BarActive" Classes="bar" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Height="{DynamicResource Avonic.Range.BarHeight}"
                                        Background="{DynamicResource Avonic.Range.BarBackgroundActive}">
                                    <Border.CornerRadius>
                                        <MultiBinding Converter="{x:Static b:BorderRadius.ToCornerRadius}">
                                            <DynamicResource ResourceKey="Avonic.Range.BarBorderRadius" />
                                            <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                                            <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </Border.CornerRadius>
                                </Border>
                                <!-- .range-tick: bar-height square, var(bar-background-active); .range-tick-active: transparent, which ActiveBackground is unset.
                                     z-index 1, over the bars. -->
                                <c:RangeTicks Name="PART_Ticks"
                                              TickSize="{DynamicResource Avonic.Range.BarHeight}"
                                              Background="{DynamicResource Avonic.Range.BarBackgroundActive}" />
                                <c:RangeKnobHandle Name="PART_KnobHandleA" Classes="knob-handle" Knob="A">
                                    <Panel Name="PART_PinA" Classes="pin" IsVisible="{TemplateBinding Pin}">
                                        <Border Classes="pin-background" />
                                        <Border Classes="pin-tip" />
                                        <TextBlock Name="PART_PinTextA" Classes="pin-text"
                                                   Text="{Binding PinText, RelativeSource={RelativeSource AncestorType=c:RangeKnobHandle}}" />
                                    </Panel>
                                    <Border Name="PART_KnobA" Classes="knob">
                                        <Border Name="PART_HaloA" Classes="halo" />
                                    </Border>
                                </c:RangeKnobHandle>
                                <c:RangeKnobHandle Name="PART_KnobHandleB" Classes="knob-handle" Knob="B" IsVisible="{TemplateBinding DualKnobs}">
                                    <Panel Name="PART_PinB" Classes="pin" IsVisible="{TemplateBinding Pin}">
                                        <Border Classes="pin-background" />
                                        <Border Classes="pin-tip" />
                                        <TextBlock Name="PART_PinTextB" Classes="pin-text"
                                                   Text="{Binding PinText, RelativeSource={RelativeSource AncestorType=c:RangeKnobHandle}}" />
                                    </Panel>
                                    <Border Name="PART_KnobB" Classes="knob">
                                        <Border Name="PART_HaloB" Classes="halo" />
                                    </Border>
                                </c:RangeKnobHandle>
                            </c:RangeSlider>
                            <!-- ::slotted([slot=end]): 14px toward the slider. -->
                            <ContentPresenter Name="PART_End" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                                              Content="{TemplateBinding EndContent}" ContentTemplate="{TemplateBinding EndContentTemplate}"
                                              IsVisible="{TemplateBinding EndContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                    </c:RangePanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- ── The host ────────────────────────────────────────────────────────────────────────── -->

        <!-- :host(.range-item-start-adjustment), :host(.range-item-end-adjustment): 18px, so that a knob at the limit isn't cut
             off by the item's padding. -->
        <Style Selector="^:range-item-start-adjustment">
            <Setter Property="Padding" Value="18,0,0,0" />
        </Style>
        <Style Selector="^:range-item-end-adjustment">
            <Setter Property="Padding" Value="0,0,18,0" />
        </Style>
        <Style Selector="^:range-item-start-adjustment:range-item-end-adjustment">
            <Setter Property="Padding" Value="18,0,18,0" />
        </Style>
        <!-- :host(.range-has-pin:not(.range-label-placement-stacked)) { padding-top: 1.75rem }: room for the pin. -->
        <Style Selector="^:range-has-pin:not(:label-placement-stacked) /template/ c|RangePanel#PART_Wrapper">
            <Setter Property="Margin" Value="0,28,0,0" />
        </Style>

        <!-- ── The label ───────────────────────────────────────────────────────────────────────── -->

        <Style Selector="^:label-text-wrapper-hidden /template/ Panel#PART_Label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- start and fixed: 16px at the end; end: 16px at the start. -->
        <Style Selector="^ /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="^:label-placement-end /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <!-- fixed: flex 0 0 100px; width 100px; min-width 100px; max-width 200px -->
        <Style Selector="^:label-placement-fixed /template/ Panel#PART_Label">
            <Setter Property="Width" Value="100" />
        </Style>
        <!-- stacked: above, at 0.75 from the top start corner, which Avalonia mirrors in RTL; 16px below; in an item 10px above;
             with a pin 1.75rem below, which is after the item's rule in the file, so it wins there too. -->
        <Style Selector="^:label-placement-stacked /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
            <Setter Property="RenderTransform" Value="scale(0.75)" />
        </Style>
        <Style Selector="^:label-placement-stacked:in-item /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="0,10,0,16" />
        </Style>
        <Style Selector="^:label-placement-stacked:range-has-pin /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="0,0,0,28" />
        </Style>
        <Style Selector="^:label-placement-stacked:range-has-pin:in-item /template/ Panel#PART_Label">
            <Setter Property="Margin" Value="0,10,0,28" />
        </Style>

        <!-- ::slotted(ion-icon[slot]) { font-size: 24px }, over the native wrapper's 0.75rem. -->
        <Style Selector="^:start-icon /template/ ContentPresenter#PART_Start">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="^:end-icon /template/ ContentPresenter#PART_End">
            <Setter Property="FontSize" Value="24" />
        </Style>

        <!-- ── The knob handle, its pin and its knob ───────────────────────────────────────────── -->

        <!-- .range-knob-handle: twice the knob, centred down, with a start margin of minus half itself, so that it's centred on
             its ratio. outline: none when focused. -->
        <Style Selector="^ /template/ c|RangeKnobHandle.knob-handle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Width">
                <MultiBinding Converter="{x:Static b:Css.Em}" ConverterParameter="2">
                    <DynamicResource ResourceKey="Avonic.Range.KnobSize" />
                </MultiBinding>
            </Setter>
            <Setter Property="Height">
                <MultiBinding Converter="{x:Static b:Css.Em}" ConverterParameter="2">
                    <DynamicResource ResourceKey="Avonic.Range.KnobSize" />
                </MultiBinding>
            </Setter>
            <Setter Property="Margin">
                <MultiBinding Converter="{x:Static b:Css.Negate}" ConverterParameter="Start">
                    <DynamicResource ResourceKey="Avonic.Range.KnobSize" />
                </MultiBinding>
            </Setter>
        </Style>

        <!-- .range-pin: 1.75rem, at the top of the handle and centred across, scaled to 0.01, its transform easing over 120ms. -->
        <Style Selector="^ /template/ Panel.pin">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RenderTransform" Value="scale(0.01)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="{a:CubicBezier 0.25, 0.1, 0.25, 1}" />
                </Transitions>
            </Setter>
        </Style>
        <!-- background: var(pin-background); border-radius: 50% -->
        <Style Selector="^ /template/ Border.pin-background">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Avonic.Range.PinBackground}" />
        </Style>
        <!-- .range-pin::before: 26px, border-radius 50% 50% 50% 0, rotated -45deg so that the square corner points down, its
             bottom 1px below the pin's, behind the text. -->
        <Style Selector="^ /template/ Border.pin-tip">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,3,1,-1" />
            <Setter Property="CornerRadius" Value="13,13,13,0" />
            <Setter Property="RenderTransform" Value="rotate(-45deg)" />
            <Setter Property="Background" Value="{DynamicResource Avonic.Range.PinBackground}" />
        </Style>
        <!-- color: var(pin-color), centred, at the native wrapper's 0.75rem. -->
        <Style Selector="^ /template/ TextBlock.pin-text">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Avonic.Range.PinColor}" />
        </Style>
        <!-- .range-knob-pressed .range-pin, .range-knob-handle.ion-focused .range-pin: translate3d(0, calc(-100% + 4px), 0) scale(1) -->
        <Style Selector="^ /template/ c|RangeKnobHandle:range-knob-pressed > Panel.pin, ^ /template/ c|RangeKnobHandle:ion-focused > Panel.pin">
            <Setter Property="RenderTransform" Value="translateY(-24px) scale(1)" />
        </Style>

        <!-- .range-knob: knob-size, centred, var(knob-background) (the active bar's), var(knob-border-radius), var(knob-box-shadow),
             scaled to 0.67, its transform and background easing over 120ms. -->
        <Style Selector="^ /template/ Border.knob">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="{DynamicResource Avonic.Range.KnobSize}" />
            <Setter Property="Height" Value="{DynamicResource Avonic.Range.KnobSize}" />
            <Setter Property="BoxShadow" Value="{DynamicResource Avonic.Range.KnobBoxShadow}" />
            <Setter Property="Background">
                <MultiBinding Converter="{x:Static b:Css.Var}">
                    <DynamicResource ResourceKey="Avonic.Range.KnobBackground" />
                    <DynamicResource ResourceKey="Avonic.Range.BarBackgroundActive" />
                </MultiBinding>
            </Setter>
            <Setter Property="CornerRadius">
                <MultiBinding Converter="{x:Static b:BorderRadius.ToCornerRadius}">
                    <DynamicResource ResourceKey="Avonic.Range.KnobBorderRadius" />
                    <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(0.67)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="{a:CubicBezier 0.25, 0.1, 0.25, 1}" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="{a:CubicBezier 0.25, 0.1, 0.25, 1}" />
                </Transitions>
            </Setter>
        </Style>
        <!-- .range-knob::before: the halo, knob-size, a circle, var(knob-background) at 0.13, scale(1), easing over 0.267s
             cubic-bezier(0, 0, 0.58, 1). -->
        <Style Selector="^ /template/ Border.halo">
            <Setter Property="Width" Value="{DynamicResource Avonic.Range.KnobSize}" />
            <Setter Property="Height" Value="{DynamicResource Avonic.Range.KnobSize}" />
            <Setter Property="CornerRadius">
                <MultiBinding Converter="{x:Static b:BorderRadius.ToCornerRadius}">
                    <DynamicResource ResourceKey="Avonic.Range.Md.HaloBorderRadius" />
                    <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter>
            <Setter Property="Background">
                <MultiBinding Converter="{x:Static b:Css.Var}">
                    <DynamicResource ResourceKey="Avonic.Range.KnobBackground" />
                    <DynamicResource ResourceKey="Avonic.Range.BarBackgroundActive" />
                </MultiBinding>
            </Setter>
            <Setter Property="Opacity" Value="0.13" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.267" Easing="{a:CubicBezier 0, 0, 0.58, 1}" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.267" Easing="{a:CubicBezier 0, 0, 0.58, 1}" />
                </Transitions>
            </Setter>
        </Style>
        <!-- .range-knob-handle:hover .range-knob:before, in @media (any-hover: hover): 2x at 0.13. A mouse or pen only. -->
        <Style Selector="^ /template/ c|RangeKnobHandle:ion-hover > Border.knob > Border.halo">
            <Setter Property="RenderTransform" Value="scale(2)" />
        </Style>
        <!-- .ion-activated, .ion-focused, .range-knob-pressed: 2x. Focused at 0.13, then activated and pressed at 0.25. -->
        <Style Selector="^ /template/ c|RangeKnobHandle:ion-focused > Border.knob > Border.halo">
            <Setter Property="RenderTransform" Value="scale(2)" />
        </Style>
        <Style Selector="^ /template/ c|RangeKnobHandle:activated > Border.knob > Border.halo, ^ /template/ c|RangeKnobHandle:range-knob-pressed > Border.knob > Border.halo">
            <Setter Property="RenderTransform" Value="scale(2)" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <!-- :host(:not(.range-has-pin)) .range-knob-pressed .range-knob, … .ion-focused .range-knob: scale(1) -->
        <Style Selector="^:not(:range-has-pin) /template/ c|RangeKnobHandle:range-knob-pressed > Border.knob, ^:not(:range-has-pin) /template/ c|RangeKnobHandle:ion-focused > Border.knob">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <!-- ── Colour ──────────────────────────────────────────────────────────────────────────── -->

        <!-- :host(.ion-color) .range-bar { background: rgba(var(ion-color-base-rgb), 0.26) } -->
        <Style Selector="^:ion-color /template/ Border#PART_Bar">
            <Setter Property="Background"
                    Value="{Binding (b:ColorPalette.BaseColor), RelativeSource={RelativeSource Self},
                                    Converter={x:Static b:ColorPalette.WithAlpha}, ConverterParameter=0.26}" />
        </Style>
        <!-- :host(.ion-color) .range-bar-active, .range-knob, .range-knob::before, .range-pin, .range-pin::before, .range-tick:
             background: var(ion-color-base); color: var(ion-color-contrast). Active ticks too, over .range-tick-active. -->
        <Style Selector="^:ion-color /template/ Border#PART_BarActive, ^:ion-color /template/ Border.knob, ^:ion-color /template/ Border.halo, ^:ion-color /template/ Border.pin-background, ^:ion-color /template/ Border.pin-tip">
            <Setter Property="Background" Value="{Binding (b:ColorPalette.Base), RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^:ion-color /template/ TextBlock.pin-text">
            <Setter Property="Foreground" Value="{Binding (b:ColorPalette.Contrast), RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^:ion-color /template/ c|RangeTicks#PART_Ticks">
            <Setter Property="Background" Value="{Binding (b:ColorPalette.Base), RelativeSource={RelativeSource Self}}" />
            <Setter Property="ActiveBackground" Value="{Binding (b:ColorPalette.Base), RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- ── Disabled, after colour, which it beats ──────────────────────────────────────────── -->

        <!-- :host(.range-disabled) .range-bar-active, .range-bar, .range-tick: var(ion-color-step-250), active ticks too. -->
        <Style Selector="^:range-disabled /template/ Border.bar">
            <Setter Property="Background" Value="{DynamicResource Avonic.BackgroundColorStep250Brush}" />
        </Style>
        <Style Selector="^:range-disabled /template/ c|RangeTicks#PART_Ticks">
            <Setter Property="Background" Value="{DynamicResource Avonic.BackgroundColorStep250Brush}" />
            <Setter Property="ActiveBackground" Value="{DynamicResource Avonic.BackgroundColorStep250Brush}" />
        </Style>
        <!-- :host(.range-disabled) .range-knob: scale(0.55), outline 5px solid #fff, which follows the corners, as a spread
             shadow does, and the same grey. -->
        <Style Selector="^:range-disabled /template/ Border.knob">
            <Setter Property="RenderTransform" Value="scale(0.55)" />
            <Setter Property="BoxShadow" Value="{DynamicResource Avonic.Range.Md.DisabledKnobOutline}" />
            <Setter Property="Background" Value="{DynamicResource Avonic.BackgroundColorStep250Brush}" />
        </Style>
        <!-- :host(.range-disabled) .label-text-wrapper, ::slotted([slot=start]), ::slotted([slot=end]): opacity 0.38 -->
        <Style Selector="^:range-disabled /template/ Panel#PART_Label, ^:range-disabled /template/ ContentPresenter#PART_Start, ^:range-disabled /template/ ContentPresenter#PART_End">
            <Setter Property="Opacity" Value="0.38" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
