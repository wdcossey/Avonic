<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-searchbar's variables, with their md values from searchbar.md.css. A CssUnset key falls back to something else in
         Ionic: the theme's bindings say what. Any value overrides it. -->

    <!-- background: var(ion-background-color, #fff). A known Color's base beats it. -->
    <SolidColorBrush x:Key="Avonic.Searchbar.Background" Color="{DynamicResource Avonic.BackgroundColor}" />
    <!-- border-radius: 2px -->
    <CornerRadius x:Key="Avonic.Searchbar.BorderRadius">2</CornerRadius>
    <!-- box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 3px 1px -2px rgba(0, 0, 0, 0.2), 0 1px 5px 0 rgba(0, 0, 0, 0.12) -->
    <BoxShadows x:Key="Avonic.Searchbar.BoxShadow">0 2 2 0 #24000000, 0 3 1 -2 #33000000, 0 1 5 0 #1F000000</BoxShadows>
    <!-- cancel-button-color: var(ion-color-step-900, var(ion-text-color-step-100, #1a1a1a)). A known Color's contrast beats it. -->
    <SolidColorBrush x:Key="Avonic.Searchbar.CancelButtonColor" Color="{DynamicResource Avonic.TextColorStep100}" />
    <!-- clear-button-color: initial, which makes color inherit: the host's colour, measured #262626 -->
    <b:CssUnset x:Key="Avonic.Searchbar.ClearButtonColor" />
    <!-- color: var(ion-color-step-850, var(ion-text-color-step-150, #262626)). A known Color's contrast beats it. -->
    <SolidColorBrush x:Key="Avonic.Searchbar.Color" Color="{DynamicResource Avonic.TextColorStep150}" />
    <!-- icon-color: var(ion-color-step-600, var(ion-text-color-step-400, #666666)). A known Color's contrast beats it. -->
    <SolidColorBrush x:Key="Avonic.Searchbar.IconColor" Color="{DynamicResource Avonic.TextColorStep400}" />
    <!-- placeholder-color: initial: the input's own colour, measured -->
    <b:CssUnset x:Key="Avonic.Searchbar.PlaceholderColor" />
    <!-- placeholder-font-style, placeholder-font-weight: initial: the input's own -->
    <b:CssUnset x:Key="Avonic.Searchbar.PlaceholderFontStyle" />
    <b:CssUnset x:Key="Avonic.Searchbar.PlaceholderFontWeight" />
    <!-- placeholder-opacity: var(ion-placeholder-opacity, 0.6) -->
    <b:CssUnset x:Key="Avonic.Searchbar.PlaceholderOpacity" />

    <!-- :host(.searchbar-disabled): opacity: 0.4, which CSS applies to the searchbar as a group. Avalonia's Opacity fades each
         part on its own, so the input's white would let its shadow show through; a mask is a group, and only its alpha counts.
         Not an Ionic variable. -->
    <SolidColorBrush x:Key="Avonic.Searchbar.Md.DisabledMask" Color="#000000" Opacity="0.4" />

</ResourceDictionary>
