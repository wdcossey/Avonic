<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Avonic.Components.Animation">
    <!-- ion-toggle's variables, with their md values on :host. -->
    <!-- track-background: rgba(var(ion-text-color-rgb, 0, 0, 0), 0.39) -->
    <SolidColorBrush x:Key="Avonic.Toggle.TrackBackground" Color="{DynamicResource Avonic.TextColor}" Opacity="0.39" />
    <!-- track-background-checked: rgba(var(ion-color-primary-rgb, 0, 84, 233), 0.5). A known Color beats it. -->
    <SolidColorBrush x:Key="Avonic.Toggle.TrackBackgroundChecked" Color="{DynamicResource Avonic.Color.Primary}" Opacity="0.5" />
    <!-- border-radius: 14px, which CSS clamps to half the track's height. A CornerRadius, a number, or a string as CSS writes
         border-radius. See BorderRadius in Avonic.Components. -->
    <CornerRadius x:Key="Avonic.Toggle.BorderRadius">14</CornerRadius>
    <!-- handle-background: #ffffff -->
    <SolidColorBrush x:Key="Avonic.Toggle.HandleBackground" Color="#FFFFFF" />
    <!-- handle-background-checked: var(ion-color-primary, #0054e9). A known Color beats it. -->
    <SolidColorBrush x:Key="Avonic.Toggle.HandleBackgroundChecked" Color="{DynamicResource Avonic.Color.Primary}" />
    <!-- handle-border-radius: 50%, of the handle's size. As border-radius. -->
    <x:String x:Key="Avonic.Toggle.HandleBorderRadius">50%</x:String>
    <!-- handle-box-shadow: 0 3px 1px -2px rgba(0, 0, 0, 0.2), 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 1px 5px 0 rgba(0, 0, 0, 0.12) -->
    <BoxShadows x:Key="Avonic.Toggle.HandleBoxShadow">0 3 1 -2 #33000000, 0 2 2 0 #24000000, 0 1 5 0 #1F000000</BoxShadows>
    <!-- handle-width: 20px -->
    <x:Double x:Key="Avonic.Toggle.HandleWidth">20</x:Double>
    <!-- handle-height: 20px -->
    <x:Double x:Key="Avonic.Toggle.HandleHeight">20</x:Double>
    <!-- handle-max-height: calc(100% + 6px), of md's 14 px track. A number, so a track restyled to another height needs this too. -->
    <x:Double x:Key="Avonic.Toggle.HandleMaxHeight">20</x:Double>
    <!-- handle-spacing: 0. The handle's inset from the track's start, and twice it back when checked. -->
    <x:Double x:Key="Avonic.Toggle.HandleSpacing">0</x:Double>
    <!-- handle-transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1), background-color 160ms cubic-bezier(0.4, 0, 0.2, 1).
         On the handle and on the wrapper that moves it, as Ionic sets it on both. -->
    <Transitions x:Key="Avonic.Toggle.HandleTransition">
        <TransformOperationsTransition Property="{x:Static Visual.RenderTransformProperty}" Duration="0:0:0.16" Easing="{a:CubicBezier 0.4, 0, 0.2, 1}" />
        <BrushTransition Property="{x:Static Border.BackgroundProperty}" Duration="0:0:0.16" Easing="{a:CubicBezier 0.4, 0, 0.2, 1}" />
    </Transitions>

    <!-- What toggle.md.css gives the on/off icon, with no variable: color: #000, and var(ion-color-contrast, #fff) when checked.
         These aren't Ionic's variables. -->
    <SolidColorBrush x:Key="Avonic.Toggle.Md.HandleColor" Color="#000000" />
    <SolidColorBrush x:Key="Avonic.Toggle.Md.HandleColorChecked" Color="#FFFFFF" />

    <!-- :host(.toggle-disabled): opacity: 0.38, which CSS applies to the toggle as a group: the white handle hides the track
         under it. Avalonia's Opacity fades each part on its own, so the track shows through, measured. A mask is a group, and
         only its alpha counts. Not an Ionic variable. -->
    <SolidColorBrush x:Key="Avonic.Toggle.Md.DisabledMask" Color="#000000" Opacity="0.38" />
</ResourceDictionary>
