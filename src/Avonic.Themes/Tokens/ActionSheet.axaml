<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- The variables of ion-action-sheet, md. A size takes a number (px) or a CSS string: px, a percentage of the window, vw and vh,
         sums and differences ("100% - 40px"), calc(), min(a, b), or "auto" ("none" for a maximum). A key set to CssUnset falls back
         as its comment says, as the variable does in action-sheet.md.css. -->

    <!-- backdrop-opacity: var(ion-backdrop-opacity, 0.32). Unset, it follows Avonic.BackdropOpacity. Read by the animations. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.BackdropOpacity" />
    <!-- background, of each group: var(ion-overlay-background-color, var(ion-background-color, #fff)). Unset, it follows
         Avonic.OverlayBackgroundColorBrush. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.Background" />
    <!-- color, of the title, the sub title and the icons: rgba(ion-text-color-rgb, 0.54) -->
    <SolidColorBrush x:Key="Avonic.ActionSheet.Color" Color="{DynamicResource Avonic.TextColor}" Opacity="0.54" />

    <x:String x:Key="Avonic.ActionSheet.Width">100%</x:String>
    <x:String x:Key="Avonic.ActionSheet.MinWidth">auto</x:String>
    <x:Double x:Key="Avonic.ActionSheet.MaxWidth">500</x:Double>
    <x:String x:Key="Avonic.ActionSheet.Height">auto</x:String>
    <x:String x:Key="Avonic.ActionSheet.MinHeight">auto</x:String>
    <!-- max-height: calc(100% - (ion-safe-area-top + ion-safe-area-bottom)). Unset, that's what it is, from Avonic.SafeAreaTop and
         Avonic.SafeAreaBottom; set, it wins as it is. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.MaxHeight" />

    <!-- button-background: transparent -->
    <SolidColorBrush x:Key="Avonic.ActionSheet.ButtonBackground" Color="Transparent" />
    <!-- button-background-activated: transparent, at 0. md's ripple shows the press instead. -->
    <SolidColorBrush x:Key="Avonic.ActionSheet.ButtonBackgroundActivated" Color="Transparent" />
    <x:Double x:Key="Avonic.ActionSheet.ButtonBackgroundActivatedOpacity">0</x:Double>
    <!-- button-background-focused: currentColor, at 0.12. Unset, it follows the button's Foreground. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonBackgroundFocused" />
    <x:Double x:Key="Avonic.ActionSheet.ButtonBackgroundFocusedOpacity">0.12</x:Double>
    <!-- button-background-hover: currentColor, at 0.04 -->
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonBackgroundHover" />
    <x:Double x:Key="Avonic.ActionSheet.ButtonBackgroundHoverOpacity">0.04</x:Double>
    <!-- button-background-selected: currentColor, at 0 -->
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonBackgroundSelected" />
    <x:Double x:Key="Avonic.ActionSheet.ButtonBackgroundSelectedOpacity">0</x:Double>

    <!-- button-color: var(ion-color-step-850, var(ion-text-color-step-150, #262626)). Unset, it follows
         Avonic.TextColorStep150Brush. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColor" />
    <!-- button-color-activated, -focused, -hover, -selected, -disabled: var(button-color). Unset, each follows
         Avonic.ActionSheet.ButtonColor. -->
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColorActivated" />
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColorFocused" />
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColorHover" />
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColorSelected" />
    <b:CssUnset x:Key="Avonic.ActionSheet.ButtonColorDisabled" />

    <!-- .action-sheet-button:disabled's opacity: 0.4, as a mask over the whole button, as CSS fades it as one: only its alpha
         counts. Not an Ionic variable. -->
    <SolidColorBrush x:Key="Avonic.ActionSheet.Md.DisabledMask" Color="#000000" Opacity="0.4" />
    <!-- The sides of a group's padding that aren't the safe area. -->
    <x:Double x:Key="Avonic.ActionSheet.Md.NoPadding">0</x:Double>

</ResourceDictionary>
