<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-skeleton-text's variables, from skeleton-text.css. Each is unset, so the theme falls back as Ionic does. -->

    <!-- background: rgba(var(background-rgb, var(ion-text-color-rgb, 0, 0, 0)), 0.065). Set, it replaces that, but not the
         animated gradient, which reads only background-rgb. A brush. -->
    <b:CssUnset x:Key="Avonic.SkeletonText.Background" />

    <!-- background-rgb: unset, so Avonic.TextColor. A Color, whose alpha isn't read, as rgba() takes only the three. -->
    <b:CssUnset x:Key="Avonic.SkeletonText.BackgroundRgb" />

    <!-- border-radius: unset, so inherit, the parent's. A CornerRadius, a number, or a string as CSS writes border-radius,
         such as 50%, which is of the box's size. See BorderRadius in Avonic.Components. -->
    <b:CssUnset x:Key="Avonic.SkeletonText.BorderRadius" />

</ResourceDictionary>
