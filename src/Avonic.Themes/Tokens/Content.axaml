<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-content's variables. A CssUnset key falls back to something else in Ionic: the theme's bindings
         say what. offset-top and offset-bottom have no key: Ionic sets them inline on the host, which beats
         any value an app gives them, measured, so here they follow Fullscreen only. -->
    <b:CssUnset x:Key="Avonic.Content.Background" />
    <b:CssUnset x:Key="Avonic.Content.Color" />
    <x:Double x:Key="Avonic.Content.KeyboardOffset">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingTop">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingBottom">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingStart">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingEnd">0</x:Double>

    <!-- ion-safe-area-*, which ion-item, ion-header, ion-footer, ion-toolbar and ion-fab read, and ion-content
         doesn't. Zero is the right default: Avalonia pads its root view by the safe area itself, through
         TopLevel.AutoSafeAreaPadding. An app that turns that off sets these from InsetsManager.SafeAreaPadding.
         They're here because ion-item deferred them to this control. See docs/components/ion-content/PLAN.md. -->
    <x:Double x:Key="Avonic.SafeAreaTop">0</x:Double>
    <x:Double x:Key="Avonic.SafeAreaBottom">0</x:Double>
    <x:Double x:Key="Avonic.SafeAreaLeft">0</x:Double>
    <x:Double x:Key="Avonic.SafeAreaRight">0</x:Double>

</ResourceDictionary>
