<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-content's variables. A CssUnset key falls back to something else in Ionic: the theme's bindings
         say what. offset-top and offset-bottom have no key: Ionic sets them inline on the host, which beats
         any value an app gives them, measured, so here they follow Fullscreen only. -->
    <b:CssUnset x:Key="Avonic.Content.Background" />
    <b:CssUnset x:Key="Avonic.Content.Color" />
    <x:Double x:Key="Avonic.Content.KeyboardOffset">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingTop">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingBottom">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingStart">0</x:Double>
    <x:Double x:Key="Avonic.Content.PaddingEnd">0</x:Double>

    <!-- Not Ionic's: what a phone's browser draws on a scroller, measured in Chromium's Android emulation. The scroll indicator's
         thumb, rgba(128, 128, 128, 0.5), the same on a dark page; and the focus ring a scroller gets from Tab, Android's
         focus ring colour. -->
    <Color x:Key="Avonic.Content.ScrollIndicatorColor">#80808080</Color>
    <SolidColorBrush x:Key="Avonic.Content.ScrollIndicatorBrush" Color="{DynamicResource Avonic.Content.ScrollIndicatorColor}" />
    <Color x:Key="Avonic.Content.FocusRingColor">#E59700</Color>
    <SolidColorBrush x:Key="Avonic.Content.FocusRingBrush" Color="{DynamicResource Avonic.Content.FocusRingColor}" />
    <!-- Where the ring sits around the scroller: a pixel outside, with a thickness of 2, so from 1 outside to 1 inside. -->
    <Thickness x:Key="Avonic.Content.FocusRingMargin">-1</Thickness>

    <!-- Not Ionic's: the scroll bar a content has with ScrollBars on, desktop Chromium's on Windows 11, measured with no emulation.
         The track and the corner; the arrows and the thumb; and those under the pointer, and the thumb while it's dragged. Ionic's
         dark palettes set no color-scheme, so Chromium's bar stays this light on a dark page, and these have no dark values. -->
    <Color x:Key="Avonic.Content.ScrollBarTrackColor">#FCFCFC</Color>
    <SolidColorBrush x:Key="Avonic.Content.ScrollBarTrackBrush" Color="{DynamicResource Avonic.Content.ScrollBarTrackColor}" />
    <Color x:Key="Avonic.Content.ScrollBarThumbColor">#8B8B8B</Color>
    <SolidColorBrush x:Key="Avonic.Content.ScrollBarThumbBrush" Color="{DynamicResource Avonic.Content.ScrollBarThumbColor}" />
    <Color x:Key="Avonic.Content.ScrollBarThumbHoverColor">#636363</Color>
    <SolidColorBrush x:Key="Avonic.Content.ScrollBarThumbHoverBrush" Color="{DynamicResource Avonic.Content.ScrollBarThumbHoverColor}" />

</ResourceDictionary>
