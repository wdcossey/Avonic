<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-item-divider's variables, with md defaults from item-divider.md.css. A CssUnset key falls back to
         something else in Ionic: the theme's bindings say what. Any brush overrides it. -->
    <b:CssUnset x:Key="Avonic.ItemDivider.Background" />
    <b:CssUnset x:Key="Avonic.ItemDivider.Color" />
    <x:Double x:Key="Avonic.ItemDivider.PaddingTop">0</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.PaddingEnd">0</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.PaddingBottom">0</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.PaddingStart">16</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.InnerPaddingTop">0</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.InnerPaddingEnd">16</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.InnerPaddingBottom">0</x:Double>
    <x:Double x:Key="Avonic.ItemDivider.InnerPaddingStart">0</x:Double>

</ResourceDictionary>
