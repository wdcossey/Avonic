<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ion-refresher has no CSS variables. md's native icon reads global ones with literal fallbacks, which Ionic's light
         theme doesn't set, so these are the literals Chromium shows: border: 1px solid var(ion-color-step-200,
         var(ion-background-color-step-200, #ececec)); background: var(ion-color-step-250, var(ion-background-color-step-250,
         #ffffff)). Avonic.BackgroundColorStep200 and 250 are set by default, and aren't these. -->
    <SolidColorBrush x:Key="Avonic.Refresher.Md.NativeIconBorderBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="Avonic.Refresher.Md.NativeIconBackgroundBrush" Color="#FFFFFF" />

    <!-- box-shadow: 0px 1px 6px rgba(0, 0, 0, 0.1). Avalonia's blur isn't CSS's: 6 is 9.4 here, the ratio of 1.56 found for ion-reorder, which puts every pixel sampled below the icon within 3 levels of Chromium's (COMPARISON.md). -->
    <BoxShadows x:Key="Avonic.Refresher.Md.NativeIconBoxShadow">0 1 9.4 0 #1A000000</BoxShadows>

</ResourceDictionary>
