<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Avonic.Components.Behaviors">

    <!-- ion-input's variables, with md defaults from input.md.css. A CssUnset key falls back to something else in Ionic,
         often a value that depends on the fill: the theme's bindings say what. Any value overrides it. -->
    <b:CssUnset x:Key="Avonic.Input.Background" />
    <b:CssUnset x:Key="Avonic.Input.BorderColor" />
    <b:CssUnset x:Key="Avonic.Input.BorderRadius" />
    <x:Double x:Key="Avonic.Input.BorderWidth">1</x:Double>
    <b:CssUnset x:Key="Avonic.Input.Color" />
    <b:CssUnset x:Key="Avonic.Input.HighlightColorFocused" />
    <SolidColorBrush x:Key="Avonic.Input.HighlightColorInvalid" Color="{DynamicResource Avonic.Color.Danger}" />
    <SolidColorBrush x:Key="Avonic.Input.HighlightColorValid" Color="{DynamicResource Avonic.Color.Success}" />
    <x:Double x:Key="Avonic.Input.HighlightHeight">2</x:Double>
    <b:CssUnset x:Key="Avonic.Input.PaddingTop" />
    <b:CssUnset x:Key="Avonic.Input.PaddingEnd" />
    <b:CssUnset x:Key="Avonic.Input.PaddingBottom" />
    <b:CssUnset x:Key="Avonic.Input.PaddingStart" />
    <b:CssUnset x:Key="Avonic.Input.PlaceholderColor" />
    <b:CssUnset x:Key="Avonic.Input.PlaceholderFontStyle" />
    <b:CssUnset x:Key="Avonic.Input.PlaceholderFontWeight" />
    <b:CssUnset x:Key="Avonic.Input.PlaceholderOpacity" />

    <!-- md's defaults for the variables above that depend on the fill or the shape. The background is transparent with no
         fill, which still takes a click, as the label does. -->
    <SolidColorBrush x:Key="Avonic.Input.Md.Background" Color="Transparent" />
    <x:Double x:Key="Avonic.Input.Md.PaddingFill">16</x:Double>
    <x:Double x:Key="Avonic.Input.Md.PaddingOutlineRound">32</x:Double>
    <x:Double x:Key="Avonic.Input.Md.BorderRadiusFill">4</x:Double>
    <x:Double x:Key="Avonic.Input.Md.BorderRadiusRound">16</x:Double>
    <x:Double x:Key="Avonic.Input.Md.BorderRadiusOutlineRound">28</x:Double>

</ResourceDictionary>
