<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Avonic.Themes</PackageId>
    <Description>Default theme for Avonic.Components: a recreation of Ionic's Material Design mode, with every Ionic CSS variable exposed as a resource key.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- *.axaml files are included automatically by Avalonia 12's build props. -->

  <!-- Merged by AvonicTheme; see Directory.Build.targets. Palettes are merged by the consumer:
       merging one here would replace the light values. -->
  <ItemGroup>
    <AvonicDiscoveredXaml Include="Tokens/**/*.axaml;Controls/**/*.axaml" Exclude="Tokens/Palettes/**/*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avonic.Components.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avonic.Components\Avonic.Components.csproj" />
  </ItemGroup>

</Project>
