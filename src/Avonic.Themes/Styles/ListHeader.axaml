<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Avonic.Components.Controls">

    <!-- align-items: center on what a panel holds, as a panel fills a FlexSlot. A ControlTheme can't reach slotted content. A ContentControl is its content's logical parent, so '>' starts from the host. -->
    <Style Selector="c|AvonicListHeader > :is(Panel) > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
