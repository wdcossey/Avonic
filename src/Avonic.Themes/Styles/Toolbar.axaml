<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:Avonic.Components.Behaviors"
        xmlns:c="using:Avonic.Components.Controls">

    <!-- What a header or footer does to its toolbars, what ion-buttons does to the buttons in it (buttons.md.css), and what
         button.md.css does to a button in a toolbar (.in-toolbar). A ControlTheme can't reach any of them.

         A button's theme sets most of these in rules with a pseudoclass, which beat a global rule without one. So each rule
         here has a pseudoclass that's always true for its case, and then beats the theme, as global styles beat a
         ControlTheme. Within this file, later beats earlier. A button's own Avonic.Button.* keys stay first, as they do in
         Styles/Button.axaml for an item. -->

    <!-- ion-header ion-toolbar:first-of-type { padding-top: var(ion-safe-area-top) } -->
    <Style Selector="c|AvonicHeader > c|AvonicToolbar:nth-child(1)">
        <Setter Property="Padding">
            <MultiBinding Converter="{x:Static c:AvonicToolbar.SafeAreaPadding}" ConverterParameter="Top">
                <DynamicResource ResourceKey="Avonic.SafeAreaLeft" />
                <DynamicResource ResourceKey="Avonic.SafeAreaRight" />
                <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                <DynamicResource ResourceKey="Avonic.SafeAreaTop" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ion-footer.footer-toolbar-padding ion-toolbar:last-of-type { padding-bottom: var(ion-safe-area-bottom) } -->
    <Style Selector="c|AvonicFooter > c|AvonicToolbar:nth-last-child(1)">
        <Setter Property="Padding">
            <MultiBinding Converter="{x:Static c:AvonicToolbar.SafeAreaPadding}" ConverterParameter="Bottom">
                <DynamicResource ResourceKey="Avonic.SafeAreaLeft" />
                <DynamicResource ResourceKey="Avonic.SafeAreaRight" />
                <Binding Path="FlowDirection" RelativeSource="{RelativeSource Self}" />
                <DynamicResource ResourceKey="Avonic.SafeAreaBottom" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- .in-toolbar:not(.ion-color):not(.in-toolbar-color) .button-native { color: var(ion-toolbar-color, var(color)) }. Any
         button in a toolbar, in ion-buttons or not. -->
    <Style Selector="c|AvonicToolbar:not(:ion-color) c|AvonicButton:not(:ion-color) /template/ Border#PART_Native">
        <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.ToolbarColorBrush" />
                <Binding Path="$parent[c:AvonicButton].Foreground" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- .button-solid.in-toolbar…: background var(ion-toolbar-color, var(background)), color var(ion-toolbar-background, var(color)) -->
    <Style Selector="c|AvonicToolbar:not(:ion-color) c|AvonicButton:fill-solid:not(:ion-color) /template/ Border#PART_Native">
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.ToolbarColorBrush" />
                <DynamicResource ResourceKey="Avonic.Button.Background" />
                <DynamicResource ResourceKey="Avonic.Color.PrimaryBrush" />
            </MultiBinding>
        </Setter>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Avonic.ToolbarBackgroundBrush}" />
    </Style>

    <!-- .button-outline.ion-activated.in-toolbar… { background: var(ion-toolbar-background, …) }. Its color falls back to
         an invalid list, so the text inherits. -->
    <Style Selector="c|AvonicToolbar:not(:ion-color) c|AvonicButton:fill-outline:activated:not(:ion-color) /template/ Border#PART_Native">
        <Setter Property="Background" Value="{DynamicResource Avonic.ToolbarBackgroundBrush}" />
    </Style>

    <!-- ion-button's inToolbar is closest('ion-buttons'): with no fill it's clear. A Fill the app sets wins.
         ::slotted(*) ion-button { margin: 0 2px } -->
    <Style Selector="c|AvonicButtons c|AvonicButton">
        <Setter Property="Fill" Value="Clear" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!-- ::slotted(*) ion-button { padding: 3px 8px; min-height: 32px } -->
    <Style Selector="c|AvonicButtons c|AvonicButton:not(:has-icon-only)">
        <Setter Property="MinHeight" Value="32" />
        <Style Selector="^ /template/ c|ButtonInner#PART_Inner">
            <Setter Property="Margin">
                <MultiBinding Converter="{x:Static c:AvonicButton.PaddingConverter}" ConverterParameter="8 3">
                    <Binding Path="$parent[c:AvonicButton].FontSize" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingStart" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingTop" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingEnd" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingBottom" />
                </MultiBinding>
            </Setter>
        </Style>
    </Style>

    <!-- ::slotted(*) .button-has-icon-only { padding-top: 0; padding-bottom: 0 }, ::slotted(*) ion-icon[slot=icon-only] { font-size: 1.8em; margin: 0 } -->
    <Style Selector="c|AvonicButtons c|AvonicButton:has-icon-only">
        <Setter Property="MinHeight" Value="32" />
        <Style Selector="^ /template/ c|ButtonInner#PART_Inner">
            <Setter Property="Margin">
                <MultiBinding Converter="{x:Static c:AvonicButton.PaddingConverter}" ConverterParameter="8 0">
                    <Binding Path="$parent[c:AvonicButton].FontSize" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingStart" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingTop" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingEnd" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingBottom" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_IconOnly > c|AvonicIcon">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize">
                <MultiBinding Converter="{x:Static b:Css.Em}" ConverterParameter="1.8">
                    <Binding Path="$parent[c:AvonicButton].FontSize" />
                </MultiBinding>
            </Setter>
        </Style>
    </Style>

    <!-- ::slotted(*) ion-button:not(.button-round) { border-radius: 2px } -->
    <Style Selector="c|AvonicButtons c|AvonicButton:not(:shape-round) /template/ Border#PART_Native">
        <Setter Property="CornerRadius">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.BorderRadius" />
                <DynamicResource ResourceKey="Avonic.Buttons.Md.ButtonBorderRadius" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ::slotted(*) .button-has-icon-only.button-clear: 48 square, padding 12, border-radius 50%, no margin. And
         rippleType: unbounded for a clear, icon-only button in ion-buttons. -->
    <Style Selector="c|AvonicButtons c|AvonicButton:has-icon-only:fill-clear">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Style Selector="^ /template/ c|ButtonInner#PART_Inner">
            <Setter Property="Margin">
                <MultiBinding Converter="{x:Static c:AvonicButton.PaddingConverter}" ConverterParameter="12 12">
                    <Binding Path="$parent[c:AvonicButton].FontSize" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingStart" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingTop" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingEnd" />
                    <DynamicResource ResourceKey="Avonic.Button.PaddingBottom" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_Native">
            <Setter Property="CornerRadius">
                <MultiBinding Converter="{x:Static b:Css.Var}">
                    <DynamicResource ResourceKey="Avonic.Button.BorderRadius" />
                    <DynamicResource ResourceKey="Avonic.Buttons.Md.ButtonBorderRadiusIconOnly" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="^ /template/ c|AvonicRippleEffect#PART_Ripple">
            <Setter Property="Type" Value="Unbounded" />
        </Style>
    </Style>

    <!-- ::slotted(*) ion-icon[slot=start] { margin-inline-end: 0.3em; font-size: 1.4em }, in the icon's own em -->
    <Style Selector="c|AvonicButtons c|AvonicButton /template/ ContentPresenter#PART_Start > c|AvonicIcon">
        <Setter Property="Margin" Value="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static c:AvonicButton.IconMarginConverter}, ConverterParameter='0,0.3'}" />
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static b:Css.Em}" ConverterParameter="1.4">
                <Binding Path="$parent[c:AvonicButton].FontSize" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ::slotted(*) ion-icon[slot=end] { margin-inline-start: 0.4em; font-size: 1.4em } -->
    <Style Selector="c|AvonicButtons c|AvonicButton /template/ ContentPresenter#PART_End > c|AvonicIcon">
        <Setter Property="Margin" Value="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static c:AvonicButton.IconMarginConverter}, ConverterParameter='0.4,0'}" />
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static b:Css.Em}" ConverterParameter="1.4">
                <Binding Path="$parent[c:AvonicButton].FontSize" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ::slotted(*) .button-clear and .button-outline { color: initial }: color: var(color) is invalid, so the text
         inherits the toolbar's, in every state. Outline's border is currentColor. -->
    <Style Selector="c|AvonicButtons c|AvonicButton:fill-clear, c|AvonicButtons c|AvonicButton:fill-outline">
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.Color" />
                <Binding Path="$parent[Control].(TextElement.Foreground)" />
            </MultiBinding>
        </Setter>
    </Style>
    <Style Selector="c|AvonicButtons c|AvonicButton:fill-outline /template/ Border#PART_Native">
        <Setter Property="BorderBrush">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.BorderColor" />
                <Binding Path="(TextElement.Foreground)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ::slotted(*) .button-solid { color: var(ion-toolbar-background, …); background: var(ion-toolbar-color, var(ion-text-color, #424242)); box-shadow: none } -->
    <Style Selector="c|AvonicButtons c|AvonicButton:fill-solid">
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.Color" />
                <DynamicResource ResourceKey="Avonic.ToolbarBackgroundBrush" />
            </MultiBinding>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Native">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
    </Style>
    <Style Selector="c|AvonicButtons c|AvonicButton:fill-solid:not(:ion-color) /template/ Border#PART_Native">
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.ToolbarColorBrush" />
                <DynamicResource ResourceKey="Avonic.Button.Background" />
                <DynamicResource ResourceKey="Avonic.Toolbar.Md.ColorBrush" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- .ion-color ion-buttons .button-solid { background: var(ion-color-contrast); color: var(ion-color-base) }: in a
         coloured toolbar. The colour's variables inherit from it, as ColorPalette's do. -->
    <Style Selector="c|AvonicToolbar:ion-color c|AvonicButtons c|AvonicButton:fill-solid">
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.Color" />
                <Binding Path="(b:ColorPalette.Base)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>
    <Style Selector="c|AvonicToolbar:ion-color c|AvonicButtons c|AvonicButton:fill-solid:not(:ion-color) /template/ Border#PART_Native">
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.Background" />
                <Binding Path="(b:ColorPalette.Contrast)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>

    <!-- ::slotted(*) .button { background-hover: currentColor }, and background-focused: currentColor for each fill. In a
         coloured toolbar they're its contrast, which is the text colour too. They're set on the button, so they beat an
         app's global Avonic.Button.BackgroundHover and BackgroundFocused, as they do here. One rule for both: the overlay
         only shows when the theme raises its opacity, and activated's is 0 in md. A button's own colour keeps its own. -->
    <Style Selector="c|AvonicButtons c|AvonicButton:not(:ion-color) /template/ Border#PART_Overlay">
        <Setter Property="Background" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- .ion-color ion-buttons .button-solid { background-focused: var(ion-color-shade); background-hover: var(ion-color-base) } -->
    <Style Selector="c|AvonicToolbar:ion-color c|AvonicButtons c|AvonicButton:fill-solid:ion-focused:not(:ion-color) /template/ Border#PART_Overlay">
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.BackgroundFocused" />
                <Binding Path="(b:ColorPalette.Shade)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>
    <Style Selector="c|AvonicToolbar:ion-color c|AvonicButtons c|AvonicButton:fill-solid:ion-hover:not(:ion-color) /template/ Border#PART_Overlay">
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static b:Css.Var}">
                <DynamicResource ResourceKey="Avonic.Button.BackgroundHover" />
                <Binding Path="(b:ColorPalette.Base)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>

</Styles>
