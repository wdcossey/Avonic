<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Avonic.Components.Controls">

    <!-- ::slotted(ion-toggle[slot=start]), ::slotted(ion-toggle[slot=end]) in item.md.css: margin 0, over the 16 px that
         Styles/Item.axaml gives any child of the start and end slots. It belongs in Item.axaml, after that rule, and is here
         until that file can change: Toggle.axaml merges after Item.axaml, in ordinal order, and both rules have no activator,
         so the later wins, and an app's plain style still beats it. Not the default slot, which has no rule in Ionic. -->
    <Style Selector="c|AvonicItem /template/ ContentPresenter#PART_Start > c|AvonicToggle, c|AvonicItem /template/ ContentPresenter#PART_End > c|AvonicToggle">
        <Setter Property="Margin" Value="0" />
    </Style>

</Styles>
