<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Avonic.Components.Controls">

    <!-- fab-button.md.css's ::slotted rules. The content is the button's logical child, so '>' means the slot's child,
         as ::slotted does. -->

    <!-- ::slotted(ion-icon) { font-size: 24px } -->
    <Style Selector="c|AvonicFabButton > c|AvonicIcon">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- :host(.fab-button-in-list) ::slotted(ion-icon) { font-size: 18px } -->
    <Style Selector="c|AvonicFabButton:in-list > c|AvonicIcon">
        <Setter Property="FontSize" Value="18" />
    </Style>

</Styles>
