<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:Avonic.Components.Behaviors"
        xmlns:c="using:Avonic.Components.Controls">

    <Design.PreviewWith>
        <StackPanel Width="390">
            <c:AvonicItem Content="Avatar at the start">
                <c:AvonicItem.StartContent>
                    <c:AvonicAvatar Background="{DynamicResource Avonic.Color.PrimaryBrush}" />
                </c:AvonicItem.StartContent>
            </c:AvonicItem>
        </StackPanel>
    </Design.PreviewWith>

    <!-- avatar.md.css's ::slotted rule. The rest of avatar.md.css is in Controls/AvonicAvatar.axaml. The rules for an avatar
         in an item or a divider are in item.md.css and item-divider.md.css, so they're in Item.axaml and ItemDivider.axaml,
         after the rule for any child in a slot, which they have to follow. ion-img's ::slotted rule goes with ion-img. -->

    <!-- ::slotted(img) { border-radius: var(border-radius); width: 100%; height: 100%; object-fit: cover; overflow: hidden }.
         UniformToFill is cover, cropped from the middle. The image fills the avatar, as a ContentPresenter stretches it. -->
    <Style Selector="c|AvonicAvatar > Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="Clip">
            <MultiBinding Converter="{x:Static b:BorderRadius.ToClip}">
                <DynamicResource ResourceKey="Avonic.Avatar.BorderRadius" />
                <Binding Path="Bounds.Size" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>

</Styles>
