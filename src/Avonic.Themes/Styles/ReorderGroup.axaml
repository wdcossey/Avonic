<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Avonic.Components.Controls">

    <!-- reorder-group.css's .reorder-selected { opacity: 0.8 }, on an item being dragged. Its z-index is the group's, at style
         priority, and its shadow the group's PART_Lift, for any type of child. The class is global in Ionic, so this doesn't ask for
         the group: only the group sets it. A handle that wraps its item has the rule in its own theme. -->
    <Style Selector="c|AvonicItem:reorder-selected">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

</Styles>
