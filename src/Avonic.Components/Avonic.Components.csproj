<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Avonic.Components</PackageId>
    <Description>Avonic controls: behaviour, properties, events and structure only — no visual opinion. Pair with Avonic.Themes or your own templates.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- *.axaml files are included automatically by Avalonia 12's build props. -->

  <!-- Merged by AvonicComponentsStyles; see Directory.Build.targets. -->
  <ItemGroup>
    <AvonicDiscoveredXaml Include="Controls/**/*.axaml" />
  </ItemGroup>

  <!-- ionicons' artwork; see tools/ionicons/generate.js. Its MIT notice ships with it. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons/ionicons.br" LogicalName="Avonic.Components.Icons.ionicons.br" />
    <None Include="Icons/LICENSE" Pack="true" PackagePath="licenses/ionicons/LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avonic.Components.Tests" />
  </ItemGroup>

</Project>
