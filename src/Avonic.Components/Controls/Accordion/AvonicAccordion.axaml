<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- Functional stubs for ion-accordion and ion-accordion-group: structure only. The look is in Avonic.Themes. -->
    <ControlTheme x:Key="{x:Type c:AvonicAccordion}" TargetType="c:AvonicAccordion">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Host">
                    <Border Name="PART_Clip"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <StackPanel>
                            <c:AccordionHeaderPresenter Name="PART_Header"
                                              Content="{TemplateBinding HeaderContent}"
                                              ContentTemplate="{TemplateBinding HeaderContentTemplate}" />
                            <c:AccordionContentClip Name="PART_Content">
                                <ContentPresenter Name="PART_ContentWrapper"
                                                  Content="{TemplateBinding ContentContent}"
                                                  ContentTemplate="{TemplateBinding ContentContentTemplate}" />
                            </c:AccordionContentClip>
                        </StackPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:AvonicAccordionGroup}" TargetType="c:AvonicAccordionGroup">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
