<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- ion-toast: structure only. The look is in Avonic.Themes/Controls/AvonicToast.axaml. The host covers the overlay layer and is
         hit by nothing but the wrapper, which the panel places; the container is the flex row of the start buttons, the icon, the
         content and the end buttons. The toast fills the buttons in code. -->
    <ControlTheme x:Key="{x:Type c:AvonicToast}" TargetType="c:AvonicToast">
        <Setter Property="Template">
            <ControlTemplate>
                <c:ToastPanel Name="PART_Panel" Position="{TemplateBinding Position}">
                    <Border Name="PART_Wrapper">
                        <c:ToastContainer Name="PART_Container" ClipToBounds="True">
                            <StackPanel Name="PART_StartButtons" Orientation="Horizontal" IsVisible="False" />
                            <c:AvonicIcon Name="PART_Icon" Icon="{TemplateBinding Icon}"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <c:ToastContent Name="PART_Content" c:ToastContainer.Flex="True">
                                <StackPanel>
                                    <TextBlock Name="PART_Header" Text="{TemplateBinding Header}" TextWrapping="Wrap"
                                               IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Name="PART_Message" Text="{TemplateBinding Message}" TextWrapping="Wrap"
                                               IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </c:ToastContent>
                            <StackPanel Name="PART_EndButtons" Orientation="Horizontal" IsVisible="False" />
                        </c:ToastContainer>
                    </Border>
                </c:ToastPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:layout-stacked /template/ c|ToastContainer#PART_Container">
            <Setter Property="Wrap" Value="True" />
        </Style>
        <Style Selector="^:layout-stacked /template/ StackPanel#PART_StartButtons, ^:layout-stacked /template/ StackPanel#PART_EndButtons">
            <Setter Property="c:ToastContainer.FillsLine" Value="True" />
        </Style>
    </ControlTheme>

    <!-- .toast-button: the native button, md's ripple, and the icon and the text in a flex row (.toast-button-inner). -->
    <ControlTheme x:Key="{x:Type c:ToastNativeButton}" TargetType="c:ToastNativeButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Native" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Panel>
                        <c:AvonicRippleEffect Name="PART_Ripple" />
                        <c:FlexRow Name="PART_Inner">
                            <c:AvonicIcon Name="PART_Icon" Icon="{TemplateBinding Icon}"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Name="PART_Label" Text="{TemplateBinding Text}"
                                       IsVisible="{TemplateBinding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </c:FlexRow>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
