<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- Functional stub for ion-item-divider: structure only. The look is in Avonic.Themes. -->
    <ControlTheme x:Key="{x:Type c:AvonicItemDivider}" TargetType="c:AvonicItemDivider">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- background-clip is border-box, so a translucent border shows the host's background through it. -->
                <Border Background="{TemplateBinding Background}"
                        BackgroundSizing="OuterBorderEdge"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <c:FlexRow>
                        <c:FlexSlot Name="PART_Start"
                                    VerticalContentAlignment="Center"
                                    TextWrapping="Wrap"
                                    Content="{TemplateBinding StartContent}"
                                    ContentTemplate="{TemplateBinding StartContentTemplate}" />
                        <Border Name="PART_Inner" c:FlexRow.Flex="1">
                            <c:FlexRow>
                                <c:FlexSlot Name="PART_Container"
                                            c:FlexRow.Flex="1"
                                            VerticalContentAlignment="Center"
                                            TextWrapping="Wrap"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <c:FlexSlot Name="PART_End"
                                            VerticalContentAlignment="Center"
                                            TextWrapping="Wrap"
                                            Content="{TemplateBinding EndContent}"
                                            ContentTemplate="{TemplateBinding EndContentTemplate}" />
                            </c:FlexRow>
                        </Border>
                    </c:FlexRow>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
