<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- Functional stubs for ion-reorder and ion-reorder-group: structure only. The look is in Avonic.Themes.
         ion-reorder's shadow root is a slot whose fallback is the icon: the icon shows while there's no content. -->
    <ControlTheme x:Key="{x:Type c:AvonicReorder}" TargetType="c:AvonicReorder">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <c:AvonicIcon Name="PART_Icon"
                                  IconName="reorder-two-sharp"
                                  IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:AvonicReorderGroup}" TargetType="c:AvonicReorderGroup">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
