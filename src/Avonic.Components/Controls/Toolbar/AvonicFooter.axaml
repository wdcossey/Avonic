<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- Functional stub for ion-footer: structure only. The look is in Avonic.Themes. The toolbars stack. -->
    <ControlTheme x:Key="{x:Type c:AvonicFooter}" TargetType="c:AvonicFooter">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Native">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
