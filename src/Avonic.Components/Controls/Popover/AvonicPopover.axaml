<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- ion-popover: structure only. The look is in Avonic.Themes/Controls/AvonicPopover.axaml. The host covers the overlay layer,
         the backdrop under the wrapper, which places the content where the enter animation puts it. The content scrolls when it's
         taller than its box; the presenter's content is set by the control, while it's mounted. -->
    <ControlTheme x:Key="{x:Type c:AvonicPopover}" TargetType="c:AvonicPopover">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <c:AvonicBackdrop Name="PART_Backdrop"
                                      Visible="{TemplateBinding ShowBackdrop}"
                                      Tappable="{TemplateBinding BackdropDismiss}" />
                    <c:PopoverPanel Name="PART_Wrapper" ZIndex="10" ContentWidth="250" ContentMaxHeight="90%">
                        <Border Name="PART_Content">
                            <ScrollViewer Name="PART_Scroll" HorizontalScrollBarVisibility="Disabled">
                                <ContentPresenter Name="PART_ContentPresenter" />
                            </ScrollViewer>
                        </Border>
                    </c:PopoverPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
