<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- ion-tab-bar: structure only. The look is in Avonic.Themes/Controls/AvonicTabBar.axaml. A row of buttons that share the
         width, centred. -->
    <ControlTheme x:Key="{x:Type c:AvonicTabBar}" TargetType="c:AvonicTabBar">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <c:TabBarPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
