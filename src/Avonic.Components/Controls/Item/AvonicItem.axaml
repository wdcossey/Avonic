<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- Functional stub for ion-item: structure only. The look is in Avonic.Themes. The transparent
         panel is what makes the whole row take input, as Ionic's host does. -->
    <ControlTheme x:Key="{x:Type c:AvonicItem}" TargetType="c:AvonicItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Native">
                    <Panel Background="Transparent">
                        <Border Name="PART_Overlay" IsHitTestVisible="False" />
                        <Grid Name="PART_Layout" ColumnDefinitions="Auto,*">
                            <ContentPresenter Name="PART_Start"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding StartContent}"
                                              ContentTemplate="{TemplateBinding StartContentTemplate}" />
                            <Border Name="PART_Inner" Grid.Column="1">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <ContentPresenter Name="PART_Container"
                                                      VerticalContentAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    <ContentPresenter Name="PART_End"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding EndContent}"
                                                      ContentTemplate="{TemplateBinding EndContentTemplate}" />
                                    <c:AvonicIcon Name="PART_DetailIcon"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw"
                                                  Icon="{TemplateBinding DetailIcon}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <c:AvonicRippleEffect Name="PART_Ripple" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
