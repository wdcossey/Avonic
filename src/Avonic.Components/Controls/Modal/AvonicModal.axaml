<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Avonic.Components.Controls">

    <!-- ion-modal: structure only. The look is in Avonic.Themes/Controls/AvonicModal.axaml. The host covers the overlay layer,
         the backdrop under the wrapper, which the panel centres at its size (the full host here). The wrapper's content is set
         by the control, while it's mounted. -->
    <ControlTheme x:Key="{x:Type c:AvonicModal}" TargetType="c:AvonicModal">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <c:AvonicBackdrop Name="PART_Backdrop"
                                      Visible="{TemplateBinding ShowBackdrop}"
                                      Tappable="{TemplateBinding BackdropDismiss}" />
                    <c:ModalPanel ContentWidth="100%" ContentHeight="100%">
                        <c:ModalWrapper Name="PART_Content" ZIndex="10" ClipToBounds="True">
                            <ContentPresenter Name="PART_ContentPresenter" />
                        </c:ModalWrapper>
                    </c:ModalPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
